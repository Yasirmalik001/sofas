{%- comment -%} Preload first slide image so it shows instantly on mobile — no colour flash {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  {%- assign _first_block = section.blocks | first -%}
  {%- if _first_block.settings.mobile_image != blank -%}
    <link rel="preload" as="image"
      href="{{ _first_block.settings.mobile_image | image_url: width: 750 }}"
      imagesrcset="{{ _first_block.settings.mobile_image | image_url: width: 375 }} 375w, {{ _first_block.settings.mobile_image | image_url: width: 550 }} 550w, {{ _first_block.settings.mobile_image | image_url: width: 750 }} 750w"
      imagesizes="100vw"
      fetchpriority="high"
      media="(max-width: 749px)"
    >
  {%- endif -%}
  {%- if _first_block.settings.image != blank -%}
    <link rel="preload" as="image"
      href="{{ _first_block.settings.image | image_url: width: 1780 }}"
      imagesrcset="{{ _first_block.settings.image | image_url: width: 750 }} 750w, {{ _first_block.settings.image | image_url: width: 1100 }} 1100w, {{ _first_block.settings.image | image_url: width: 1500 }} 1500w, {{ _first_block.settings.image | image_url: width: 1780 }} 1780w, {{ _first_block.settings.image | image_url: width: 2000 }} 2000w"
      imagesizes="100vw"
      fetchpriority="high"
      media="(min-width: 750px)"
    >
  {%- endif -%}
{%- endif -%}

{%- liquid
  assign padding_bottom_desktop = section.settings.desktop_height | append: 'vh'
  assign padding_bottom_mobile = section.settings.mobile_height | append: 'vh'

  if section.settings.adapt_height_first_image and section.blocks.size > 0
    assign first_block = section.blocks.first
    if first_block.settings.image != blank
      assign padding_bottom_desktop = 1 | divided_by: first_block.settings.image.aspect_ratio | times: 100 | append: '%'
    else
      assign padding_bottom_desktop = '40%'
    endif
    
    if first_block.settings.mobile_image != blank
      assign padding_bottom_mobile = 1 | divided_by: first_block.settings.mobile_image.aspect_ratio | times: 100 | append: '%'
    elsif first_block.settings.image != blank
      assign padding_bottom_mobile = 1 | divided_by: first_block.settings.image.aspect_ratio | times: 100 | append: '%'
    else
      assign padding_bottom_mobile = '100%'
    endif
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .custom-hero-slider {
    position: relative;
    overflow: hidden;
    width: 100%;
    display: block;
  }

  .custom-hero-slider__slides {
    display: grid;
    grid-template-areas: "hero";
    width: 100%;
    position: relative;
  }

  .custom-hero-slider__slide {
    grid-area: hero;
    position: relative;
    display: flex;
    align-items: stretch;
    width: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out;
    z-index: 1;
  }

  .custom-hero-slider__slide.is-active {
    opacity: 1;
    visibility: visible;
    z-index: 2;
  }

  .custom-hero-slider__slide::before {
    content: '';
    width: 0;
    padding-bottom: {{ padding_bottom_mobile }};
  }

  .custom-hero-slider__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .custom-hero-slider__media img,
  .custom-hero-slider__picture {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .custom-hero-slider__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #000000;
    z-index: 2;
    transition: opacity 0.35s ease;
  }

  .custom-hero-slider__content-wrapper {
    position: relative;
    z-index: 3;
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .custom-hero-slider__box {
    text-align: center;
    max-width: 60rem;
    padding: 4rem 5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .custom-hero-slider__box > :first-child {
    margin-top: auto;
  }

  .custom-hero-slider__box > :last-child {
    margin-bottom: auto;
  }

  .custom-hero-slider__title {
    margin: 0;
    color: rgb(var(--color-foreground));
  }

  .custom-hero-slider__text {
    margin: 0;
    font-size: 1.6rem;
    line-height: 1.5;
    color: rgb(var(--color-foreground));
  }

  .custom-hero-slider__buttons {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      width: 100%;
  }

  @media screen and (max-width: 749px) {
    .custom-hero-slider__buttons {
      margin-top: auto;
      margin-bottom: 0px !important;
    }
  }

  .custom-hero-slider .button--secondary {
      --alpha-button-background: 0;
      --pbh-secondary-hover-text: 212 184 149;
      border: 1px solid #fff;
  }

  /* Desktop Layout */
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .custom-hero-slider__slide::before {
      padding-bottom: {{ padding_bottom_desktop }};
    }

    .custom-hero-slider__box {
      padding: 6rem 0 2rem;
      flex: 1;
      align-self: stretch;
      justify-content: center;
    }

    .custom-hero-slider__buttons {
      flex-direction: row;
      width: auto;
      gap: 1.5rem;
      margin-top: 1rem;
    }
  }

  /* Slider Controls */
  .custom-hero-slider .hero-controls {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .custom-hero-slider .hero-arrow {
    cursor: pointer;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.5);
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    color: #fff;
    padding: 0;
  }
  .custom-hero-slider .hero-arrow:hover {
    background: #fff;
    color: #000;
  }
  .custom-hero-slider .hero-arrow svg {
    width: 20px;
    height: 20px;
    stroke: currentColor;
  }
  .custom-hero-slider .hero-dots {
    position: relative;
    bottom: 0;
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .custom-hero-slider .hero-dot {
    width: 35px;
    height: 3px;
    background: #ffffff;
    opacity: 0.6;
    border-radius: 2px;
    margin: 0 !important;
    padding: 0;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .custom-hero-slider .hero-dot.is-active {
    background: #2B2B2B;
    opacity: 1;
  }

  @media screen and (max-width: 767px) {
    .custom-hero-slider .hide-on-mobile { display: none !important; }
  }
  @media screen and (min-width: 768px) {
    .custom-hero-slider .hide-on-desktop { display: none !important; }
  }
{%- endstyle -%}

<hero-slider class="custom-hero-slider section-{{ section.id }}-padding" data-autoplay="{{ section.settings.enable_autoplay }}" data-interval="{{ section.settings.autoplay_interval | times: 1000 | default: 5000 }}">
  <div class="custom-hero-slider__slides">
    {%- for block in section.blocks -%}
      <div class="custom-hero-slider__slide color-{{ block.settings.color_scheme }} gradient {% if forloop.first %}is-active{% endif %}" data-slide-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
        
        <div class="custom-hero-slider__media">
          <div class="custom-hero-slider__overlay" style="opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};"> </div>
          
          {%- if block.settings.image != blank -%}
            {%- liquid
              assign loading_strategy = 'lazy'
              assign fetch_priority = 'low'
              assign decoding_strategy = 'async'
              if forloop.first
                assign loading_strategy = 'eager'
                assign fetch_priority = 'high'
                assign decoding_strategy = 'sync'
              endif
              assign fallback_img = block.settings.image | default: block.settings.mobile_image
            -%}
            <picture class="custom-hero-slider__picture">
              {%- if block.settings.mobile_image != blank -%}
                <source media="(max-width: 749px)" srcset="{{ block.settings.mobile_image | image_url: width: 375 }} 375w, {{ block.settings.mobile_image | image_url: width: 550 }} 550w, {{ block.settings.mobile_image | image_url: width: 750 }} 750w" sizes="100vw">
              {%- endif -%}
              {%- if block.settings.image != blank -%}
                <source media="(min-width: 750px)" srcset="{{ block.settings.image | image_url: width: 750 }} 750w, {{ block.settings.image | image_url: width: 1100 }} 1100w, {{ block.settings.image | image_url: width: 1500 }} 1500w, {{ block.settings.image | image_url: width: 1780 }} 1780w, {{ block.settings.image | image_url: width: 2000 }} 2000w" sizes="100vw">
              {%- endif -%}
              {{ fallback_img | image_url: width: 1500 | image_tag:
                decoding: decoding_strategy,
                loading: loading_strategy,
                fetchpriority: fetch_priority,
                class: 'custom-hero-slider__image--main',
                sizes: '100vw'
              }}
            </picture>
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg custom-hero-slider__image--main' }}
          {%- endif -%}
        </div>

        <div class="page-width custom-hero-slider__content-wrapper" style="justify-content: {{ block.settings.desktop_content_position }};">
          <div class="custom-hero-slider__box" style="text-align: {{ block.settings.desktop_text_alignment }}; align-items: {% if block.settings.desktop_text_alignment == 'left' %}flex-start{% elsif block.settings.desktop_text_alignment == 'right' %}flex-end{% else %}center{% endif %};">
              {%- if block.settings.heading != blank -%}
                <h2 class="custom-hero-slider__title {{ block.settings.heading_size }}">
                  {{ block.settings.heading }}
                </h2>
              {%- endif -%}
              
              {%- if block.settings.text != blank -%}
                <div class="custom-hero-slider__text">
                  {{ block.settings.text }}
                </div>
              {%- endif -%}
              
              {%- if block.settings.button_label_1 != blank or block.settings.button_label_2 != blank -%}
                <div class="custom-hero-slider__buttons" style="margin-top: {{ block.settings.content_top_padding }}px;">
                  {%- if block.settings.button_label_1 != blank -%}
                    <a {% if block.settings.button_link_1 == blank %} role="link" aria-disabled="true"{% else %} href="{{ block.settings.button_link_1 }}"{% endif %} 
                       class="button {% if block.settings.button_style_1 == 'secondary' %}button--secondary{% else %}button--primary{% endif %}">
                      {{- block.settings.button_label_1 | escape -}}
                    </a>
                  {%- endif -%}
                  
                  {%- if block.settings.button_label_2 != blank -%}
                    <a {% if block.settings.button_link_2 == blank %} role="link" aria-disabled="true"{% else %} href="{{ block.settings.button_link_2 }}"{% endif %} 
                       class="button {% if block.settings.button_style_2 == 'secondary' %}button--secondary{% else %}button--primary{% endif %}">
                      {{- block.settings.button_label_2 | escape -}}
                    </a>
                  {%- endif -%}
                </div>
              {%- endif -%}
          </div>
        </div>

      </div>
    {%- endfor -%}
  </div>
  
  {%- if section.blocks.size > 1 -%}
    <div class="hero-controls">
      <button type="button" class="hero-arrow hero-prev {% unless section.settings.mobile_arrows %}hide-on-mobile{% endunless %} {% unless section.settings.desktop_arrows %}hide-on-desktop{% endunless %}" aria-label="Previous slide">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
      </button>
      
      <div class="hero-dots {% unless section.settings.mobile_dots %}hide-on-mobile{% endunless %} {% unless section.settings.desktop_dots %}hide-on-desktop{% endunless %}">
        {%- for block in section.blocks -%}
          <button type="button" class="hero-dot {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>
        {%- endfor -%}
      </div>
        
      <button type="button" class="hero-arrow hero-next {% unless section.settings.mobile_arrows %}hide-on-mobile{% endunless %} {% unless section.settings.desktop_arrows %}hide-on-desktop{% endunless %}" aria-label="Next slide">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      </button>
    </div>
  {%- endif -%}
</hero-slider>

<script>
  if (!customElements.get('hero-slider')) {
    class HeroSlider extends HTMLElement {
      constructor() {
        super();
        this.slides = Array.from(this.querySelectorAll('.custom-hero-slider__slide'));
        this.dots = Array.from(this.querySelectorAll('.hero-dot'));
        this.prevBtn = this.querySelector('.hero-prev');
        this.nextBtn = this.querySelector('.hero-next');
        this.currentIndex = 0;
        this.timer = null;
        this.autoplay = this.dataset.autoplay === 'true';
        this.interval = parseInt(this.dataset.interval) || 5000;
        this.touchStartX = 0;
        this.touchEndX = 0;
      }

      connectedCallback() {
        if (this.slides.length <= 1) return;

        if (this.prevBtn) this.prevBtn.addEventListener('click', () => this.prev());
        if (this.nextBtn) this.nextBtn.addEventListener('click', () => this.next());

        this.dots.forEach((dot, idx) => {
          dot.addEventListener('click', () => this.goTo(idx));
        });

        this.addEventListener('touchstart', (e) => {
          this.touchStartX = e.changedTouches[0].screenX;
          this.pause();
        }, { passive: true });

        this.addEventListener('touchend', (e) => {
          this.touchEndX = e.changedTouches[0].screenX;
          this.handleSwipe();
          this.play();
        }, { passive: true });

        this.addEventListener('mouseenter', () => this.pause());
        this.addEventListener('mouseleave', () => this.play());

        this.play();

        // Theme customizer event support
        document.addEventListener('shopify:block:select', (e) => {
          const blockId = e.detail.blockId;
          const slide = this.querySelector(`[data-shopify-editor-block*="${blockId}"]`) || this.slides.find(s => s.dataset.slideIndex == blockId);
          if (slide) {
            const idx = this.slides.indexOf(slide);
            if (idx !== -1) this.goTo(idx);
          }
        });
      }

      goTo(index) {
        if (index < 0) index = this.slides.length - 1;
        if (index >= this.slides.length) index = 0;
        this.currentIndex = index;

        this.slides.forEach((slide, idx) => {
          slide.classList.toggle('is-active', idx === index);
        });

        this.dots.forEach((dot, idx) => {
          dot.classList.toggle('is-active', idx === index);
        });
      }

      next() {
        this.goTo(this.currentIndex + 1);
      }

      prev() {
        this.goTo(this.currentIndex - 1);
      }

      handleSwipe() {
        const diff = this.touchStartX - this.touchEndX;
        if (Math.abs(diff) > 40) {
          if (diff > 0) this.next();
          else this.prev();
        }
      }

      play() {
        if (!this.autoplay || this.slides.length <= 1) return;
        this.pause();
        this.timer = setInterval(() => this.next(), this.interval);
      }

      pause() {
        if (this.timer) {
          clearInterval(this.timer);
          this.timer = null;
        }
      }

      disconnectedCallback() {
        this.pause();
      }
    }
    customElements.define('hero-slider', HeroSlider);
  }
</script>

{% schema %}
{
  "name": "Custom Hero Slider",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "⚙️ Slider Configuration" },
    { "type": "checkbox", "id": "enable_autoplay", "label": "Enable Autoplay", "default": true },
    { "type": "range", "id": "autoplay_interval", "min": 2, "max": 10, "step": 1, "unit": "s", "label": "Autoplay Interval", "default": 5 },
    { "type": "checkbox", "id": "desktop_arrows", "label": "Show Arrows on Desktop", "default": true },
    { "type": "checkbox", "id": "mobile_arrows", "label": "Show Arrows on Mobile", "default": false },
    { "type": "checkbox", "id": "desktop_dots", "label": "Show Dots on Desktop", "default": true },
    { "type": "checkbox", "id": "mobile_dots", "label": "Show Dots on Mobile", "default": true },
    { "type": "checkbox", "id": "adapt_height_first_image", "label": "Adapt section height to first image size", "default": false },
    { "type": "header", "content": "Desktop Layout" },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 40,
      "max": 100,
      "step": 1,
      "unit": "vh",
      "label": "Desktop section height",
      "default": 70
    },
    { "type": "header", "content": "Mobile Layout" },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 40,
      "max": 100,
      "step": 1,
      "unit": "vh",
      "label": "Mobile section height",
      "default": 60
    },
    { "type": "header", "content": "Spacing" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Image (Optional)",
          "info": "Overrides desktop image on smaller screens."
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 100,
          "step": 10,
          "unit": "%",
          "label": "Image overlay opacity",
          "default": 30
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "t:sections.all.colors.label",
          "default": "scheme-4"
        },
        {
          "type": "select",
          "id": "desktop_content_position",
          "options": [
            { "value": "flex-start", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "flex-end", "label": "Right" }
          ],
          "default": "center",
          "label": "Desktop content position"
        },
        {
          "type": "select",
          "id": "desktop_text_alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center",
          "label": "Desktop text alignment"
        },
        {
           "type": "richtext",
           "id": "heading",
           "default": "<p>LESS MAINTENANCE. MORE RIDING.</p>",
           "label": "Heading"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            { "value": "h2", "label": "Medium" },
            { "value": "h1", "label": "Large" },
            { "value": "h0", "label": "Extra Large" }
          ],
          "default": "h1",
          "label": "Heading size"
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Bring home the comfort you love and choose a payment plan that works for you.</p>",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "button_label_1",
          "default": "Explore our products",
          "label": "Primary button label"
        },
        {
          "type": "url",
          "id": "button_link_1",
          "label": "Primary button link"
        },
        {
          "type": "select",
          "id": "button_style_1",
          "options": [
            { "value": "primary", "label": "Solid" },
            { "value": "secondary", "label": "Outline" }
          ],
          "default": "primary",
          "label": "Primary button style"
        },
        {
          "type": "text",
          "id": "button_label_2",
          "label": "Secondary button label"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "Secondary button link"
        },
        {
          "type": "select",
          "id": "button_style_2",
          "options": [
            { "value": "primary", "label": "Solid" },
            { "value": "secondary", "label": "Outline" }
          ],
          "default": "secondary",
          "label": "Secondary button style"
        },
        {
          "type": "range",
          "id": "content_top_padding",
          "min": 0,
          "max": 300,
          "step": 10,
          "unit": "px",
          "label": "Button top spacing (desktop)",
          "default": 20,
          "info": "Pushes only the button down, heading and text stay centered."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Hero Slider",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
